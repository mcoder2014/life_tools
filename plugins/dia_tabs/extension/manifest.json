{
  "manifest_version": 3,
  "name": "Dia 网页标题与标签",
  "version": "1.0.0",
  "description": "保存真实网页标题，复制链接并准确切换已有 Dia 标签。",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "nativeMessaging",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开网页标题列表"
  },
  "options_page": "control.html"
}
